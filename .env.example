# ============================================================
# KuralAI - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000
APP_NAME=KuralAI
APP_URL=https://yourdomain.com

# --- JWT Auth (dashboard) ---
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=24h

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kuralai
DB_USER=kuralai_user
DB_PASSWORD=your_db_password
DB_SSL=false

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenAI (LLM + Whisper STT) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1

# --- Azure Speech (TTS - Tamil Neural Voice) ---
AZURE_SPEECH_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=ta-IN-PallaviNeural
# Available Tamil voices: ta-IN-PallaviNeural (female), ta-IN-ValluvarNeural (male)

# --- AWS S3 (Audio & Recording Storage) ---
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-south-1
S3_BUCKET_NAME=kuralai-audio-storage
S3_RECORDING_PREFIX=recordings/
S3_TTS_PREFIX=tts-cache/

# --- Call Configuration ---
MAX_CALL_DURATION_SECONDS=300
CALL_RETRY_ATTEMPTS=3
CALL_RETRY_DELAY_SECONDS=60
SILENCE_TIMEOUT_SECONDS=5
SPEECH_TIMEOUT_SECONDS=15

# --- Human Escalation ---
ESCALATION_WEBHOOK_URL=https://your-crm.com/webhook/escalate
ESCALATION_PHONE=+91xxxxxxxxxx

# --- Logging ---
LOG_LEVEL=info
LOG_FILE=logs/kuralai.log

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3001,https://yourdomain.com
